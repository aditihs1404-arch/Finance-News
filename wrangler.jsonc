// Cloudflare Worker config: serves the static site in public/ (index.html, briefs/)
// and runs worker/index.js first for the live-prices API and script injection.
{
  "name": "finance-news",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  }
}
